    "Anyone who opens this document can read them, including deleted text and who made each change. The copy keeps them too." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquiera que abra este documento puede leerlos, incluido el texto eliminado y quién hizo cada cambio. La copia también los conserva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この書類を開けば誰でも読むことができ、削除されたテキストや各変更を行った人もわかります。コピーにも残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何打开此文档的人都能读到它们，包括已删除的文字和每处更改的作者。副本也会保留它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何開啟此文件的人都能讀到它們，包括已刪除的文字和每處變更的作者。副本也會保留它們。"
          }
        }
      }
    },
