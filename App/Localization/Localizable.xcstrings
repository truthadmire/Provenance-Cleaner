    "Off by default: non-breaking and narrow spaces can be correct typography, for example in French." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado por omisión: los espacios de no separación y los espacios estrechos pueden ser tipografía correcta, por ejemplo en francés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトではオフです。ノーブレークスペースや狭いスペースは、フランス語などでは正しい組版です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认关闭：不换行空格和窄空格可能是正确的排版，例如在法语中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設關閉：不換行空格和窄空格可能是正確的排版，例如在法文中。"
          }
        }
      }
    },
    "Off: all removable metadata is stripped, including camera, location, copyright and descriptive fields." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado: se quitan todos los metadatos que se pueden quitar, incluidos cámara, ubicación, copyright y campos descriptivos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフ：カメラ、位置情報、著作権、説明のフィールドを含め、削除可能なメタデータをすべて削除します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭：移除所有可移除的元数据，包括相机、位置、版权和描述性字段。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉：移除所有可移除的元資料，包括相機、位置、版權和描述性欄位。"
          }
        }
      }
    },
