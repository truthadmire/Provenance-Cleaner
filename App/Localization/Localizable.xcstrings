{
  "sourceLanguage" : "en",
  "strings" : {
    " Its download source is now the one you set." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Ahora su origen de descarga es el que definiste."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロード元は設定した値になりました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的下载来源现在是你设置的值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的下載來源現在是你設定的值。"
          }
        }
      }
    },
    " Its download-source record was not carried over." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " No se conservó su registro de origen de descarga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロード元の記録は引き継がれていません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的下载来源记录没有保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的下載來源記錄沒有保留。"
          }
        }
      }
    },
    " Note: %@." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Nota: %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注意：%@。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注意：%@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注意：%@。"
          }
        }
      }
    },
    " Rewriting a PDF can affect forms and other interactive features." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Reescribir un PDF puede afectar a los formularios y a otras funciones interactivas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF を書き直すと、フォームなどの対話型機能に影響することがあります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重写 PDF 可能影响表单和其他交互功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重寫 PDF 可能影響表單和其他互動功能。"
          }
        }
      }
    },
    " This copy had all removable metadata stripped, including author, dates, camera, location and copyright." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " A esta copia se le quitaron todos los metadatos que se pueden quitar, incluidos autor, fechas, cámara, ubicación y copyright."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このコピーからは、作成者、日付、カメラ、位置情報、著作権を含む、削除可能なメタデータがすべて削除されています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此副本已移除所有可移除的元数据，包括作者、日期、相机、位置和版权。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此副本已移除所有可移除的元資料，包括作者、日期、相機、位置和版權。"
          }
        }
      }
    },
    "%@ (%lld more below.)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$lld more below.)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$lld más abajo)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@（ほかに %2$lld 件を下に表示）"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@（下面还有 %2$lld 条。）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@（下方還有 %2$lld 項。）"
          }
