    },
    "These checks found no hidden instructions. They can't rule out every technique." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas comprobaciones no encontraron instrucciones ocultas. No pueden descartar todas las técnicas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのチェックでは隠れた指示は見つかりませんでしたが、すべての手法を除外できるわけではありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些检查没有发现隐藏指令，但不能排除所有手法。"
          }
