    "Saving copies to a folder is safest. Replacing originals keeps a .bak backup beside every file." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardar las copias en una carpeta es lo más seguro. Al sustituir los originales se conserva una copia de seguridad .bak junto a cada archivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピーをフォルダに保存するのが最も安全です。元のファイルを置き換えると、各ファイルの隣に .bak バックアップが残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把副本存储到文件夹最安全。替换原件时，每个文件旁都会保留一个 .bak 备份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把副本儲存到資料夾最安全。取代原始檔案時，每個檔案旁都會保留一個 .bak 備份。"
          }
        }
      }
    },
    "See credentials, metadata and hidden characters." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
