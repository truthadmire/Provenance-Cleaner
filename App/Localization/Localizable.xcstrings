    "%@ couldn't be checked for content credentials (%@)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ couldn't be checked for content credentials (%2$@)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron comprobar las credenciales de contenido de %1$@ (%2$@)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ のコンテンツ認証情報を確認できませんでした（%2$@）。"
