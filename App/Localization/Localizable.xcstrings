    "“%@” is an original or a backup in the file list, so Save copy won't overwrite it. Choose another name, or use Replace original, which keeps a backup." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» es un original o una copia de seguridad de la lista de archivos, así que «Guardar copia» no lo sobrescribirá. Elige otro nombre o usa «Sustituir original», que conserva una copia de seguridad."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”はファイルリスト内の元のファイルまたはバックアップなので、「コピーを保存」では上書きしません。別の名前を選ぶか、バックアップを残す「元のファイルを置き換える」を使ってください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”是文件列表中的原件或备份，因此“存储副本”不会覆盖它。请换一个名称，或使用会保留备份的“替换原件”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」是檔案列表中的原始檔案或備份，因此「儲存副本」不會覆寫它。請換一個名稱，或使用會保留備份的「取代原始檔案」。"
          }
        }
      }
    }
