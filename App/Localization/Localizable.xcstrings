    "Translations haven't been reviewed by a native speaker. Text from your files and from AI models is never translated. Technical findings from the cleaning engine, error messages from bundled tools and the third-party notices stay in English." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las traducciones no las ha revisado un hablante nativo. El texto de tus archivos y de los modelos de IA nunca se traduce. Los hallazgos técnicos del motor de limpieza, los mensajes de error de las herramientas incluidas y los avisos de terceros siguen en inglés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "翻訳はネイティブスピーカーによる確認を受けていません。ファイルや AI モデルのテキストが翻訳されることはありません。クリーンエンジンの技術的な検出結果、同梱ツールのエラーメッセージ、サードパーティ通知は英語のままです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "译文尚未经过母语人士审校。来自你的文件和 AI 模型的文本绝不会被翻译。清理引擎的技术性发现、内置工具的错误信息和第三方声明保持英文。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "譯文尚未經過母語人士審閱。來自你的檔案和 AI 模型的文字絕不會被翻譯。清理引擎的技術性發現、內建工具的錯誤訊息和第三方聲明維持英文。"
          }
        }
      }
    },
