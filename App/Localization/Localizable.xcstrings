    "To" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終了"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到"
          }
        }
      }
    },
    "To keep a backup beside the original, Provenance Cleaner needs permission to write in “%@”. Choose Allow to grant it until you quit." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para guardar una copia de seguridad junto al original, Provenance Cleaner necesita permiso para escribir en «%@». Elige «Permitir» para concederlo hasta que salgas de la app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元のファイルの隣にバックアップを残すには、Provenance Cleaner に“%@”への書き込みを許可する必要があります。「許可」を選ぶと、終了するまで許可されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要在原件旁保留备份，Provenance Cleaner 需要在“%@”中写入的权限。选择“允许”可授予此权限，直到你退出 App。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要在原始檔案旁保留備份，Provenance Cleaner 需要在「%@」中寫入的權限。選擇「允許」可授予此權限，直到你結束 App。"
          }
        }
      }
    },
    "To keep the preview responsive, a large changed region is shown as removed and inserted blocks instead of a minimal edit. Counts describe the displayed blocks." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para que la previsualización responda con fluidez, una región muy modificada se muestra como bloques eliminados e insertados en lugar de como una edición mínima. Los recuentos describen los bloques mostrados."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレビューの反応を保つため、大きく変更された部分は最小限の差分ではなく、削除ブロックと挿入ブロックで表示します。件数は表示中のブロックについてのものです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为保持预览流畅，大范围更改的区域会显示为移除块和插入块，而不是最小编辑。计数描述的是显示出的块。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為保持預覽流暢，大範圍變更的區域會以移除區塊和插入區塊顯示，而不是最小編輯。計數描述的是顯示的區塊。"
          }
        }
      }
    },
    "To remove them, accept or reject all changes and delete the comments in Word, then add the saved file again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para eliminarlos, acepta o rechaza todos los cambios y borra los comentarios en Word, y después vuelve a añadir el archivo guardado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除するには、Word ですべての変更を承諾または却下してコメントを削除し、保存したファイルをもう一度追加してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要移除它们，请在 Word 中接受或拒绝所有更改并删除批注，然后重新添加存储后的文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要移除它們，請在 Word 中接受或拒絕所有變更並刪除註解，然後重新加入儲存後的檔案。"
          }
        }
      }
    },
