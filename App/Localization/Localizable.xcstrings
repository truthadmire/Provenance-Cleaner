    "System default" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predeterminado del sistema"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムのデフォルト"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跟随系统"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跟隨系統"
          }
        }
      }
    },
    "System default follows the language order in System Settings. The language applies to the whole app the next time it opens, so nothing is left half translated." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Predeterminado del sistema» sigue el orden de idiomas de Ajustes del Sistema. El idioma se aplica a toda la app la próxima vez que se abra, así que nada queda a medio traducir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「システムのデフォルト」は、システム設定の言語の順序に従います。言語は次に開いたときにアプリ全体に適用されるため、中途半端に翻訳された状態にはなりません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“跟随系统”会按“系统设置”中的语言顺序选择。所选语言在下次打开时应用于整个 App，不会出现只翻译一半的情况。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「跟隨系統」會依「系統設定」中的語言順序選擇。所選語言在下次開啟時套用到整個 App，不會出現只翻譯一半的情況。"
          }
        }
      }
    },
