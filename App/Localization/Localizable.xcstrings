    },
    "This check only reports. Creating a copy can remove invisible characters and some metadata, but hidden text and comments stay in it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta comprobación solo informa. Crear una copia puede eliminar caracteres invisibles y algunos metadatos, pero el texto oculto y los comentarios se quedan en ella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このチェックは報告するだけです。コピーを作成すると不可視文字や一部のメタデータは削除できますが、隠しテキストとコメントは残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此检查只作报告。创建副本可以移除不可见字符和部分元数据，但隐藏文本和批注仍会留在其中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此檢查只作報告。建立副本可以移除不可見字元和部分元資料，但隱藏文字和註解仍會留在其中。"
          }
        }
      }
    },
    "This copy doesn't include your latest changes" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta copia no incluye tus últimos cambios"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このコピーには最新の変更が含まれていません"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此副本未包含你最新的更改"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此副本未包含你最新的變更"
          }
        }
      }
    },
    "This document is digitally signed, so its editing history can't be changed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este documento tiene firma digital, así que su historial de edición no se puede cambiar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この書類にはデジタル署名があるため、編集履歴を変更できません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文档带有数字签名，因此无法更改其编辑历史。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件帶有數位簽章，因此無法變更其編輯記錄。"
          }
        }
      }
    },
    "This file couldn't be checked." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
