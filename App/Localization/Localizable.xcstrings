    },
    "Provenance Cleaner changes file metadata and removes invisible text characters." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provenance Cleaner cambia los metadatos de los archivos y elimina caracteres de texto invisibles."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provenance Cleaner は、ファイルのメタデータを変更し、テキスト内の不可視文字を削除します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provenance Cleaner 会更改文件元数据，并移除不可见的文本字符。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provenance Cleaner 會變更檔案元資料，並移除不可見的文字字元。"
          }
        }
      }
    },
    "Provenance Cleaner finds content credentials, provenance metadata and invisible characters, then makes a cleaned copy. Your originals stay as they are until you save." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provenance Cleaner encuentra credenciales de contenido, metadatos de procedencia y caracteres invisibles, y después crea una copia limpia. Tus originales no cambian hasta que guardes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provenance Cleaner は、コンテンツ認証情報、来歴メタデータ、不可視文字を見つけて、クリーンなコピーを作成します。保存するまで、元のファイルはそのままです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provenance Cleaner 会查找内容凭证、来源元数据和不可见字符，然后制作清理后的副本。在你存储之前，原件保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provenance Cleaner 會尋找內容憑證、來源元資料和不可見字元，然後製作清理後的副本。在你儲存之前，原始檔案保持不變。"
          }
        }
      }
    },
    "Provenance metadata in the media file." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
