    "It was created, but checking it again failed. Review it carefully before you save." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se creó, pero no se pudo volver a comprobar. Revísala con cuidado antes de guardar."
          }
        },
        "ja" : {
          "stringUnit" : {
