      }
    },
    "The original is first copied to %@.bak. An existing backup is never overwritten." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero se copia el original a %@.bak. Una copia de seguridad existente nunca se sobrescribe."
          }
