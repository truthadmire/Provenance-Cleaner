          }
        }
      }
    },
    "The signature or content binding didn't validate. The file may have changed after it was signed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La firma o la vinculación del contenido no se validó. Puede que el archivo cambiara después de firmarse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "署名またはコンテンツの紐付けを検証できませんでした。署名後にファイルが変更された可能性があります。"
