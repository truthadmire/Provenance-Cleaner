    },
    "This file type isn't supported." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este tipo de archivo no es compatible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルの種類には対応していません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支持此文件类型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支援此檔案類型。"
          }
        }
      }
    },
    "This file's extracted text, including hidden text, comments and metadata, and a summary of the offline findings go to %@ under your API keys, and those companies' terms and pricing apply. The file itself isn't sent." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El texto extraído de este archivo, incluidos el texto oculto, los comentarios y los metadatos, y un resumen de los resultados sin conexión se envían a %@ con tus claves de API, y se aplican las condiciones y los precios de esas empresas. El archivo en sí no se envía."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルから抽出したテキスト（隠しテキスト、コメント、メタデータを含む）とオフラインのチェック結果の要約が、あなたの API キーで %@ に送信され、これらの企業の規約と料金が適用されます。ファイル自体は送信されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件提取出的文本（包括隐藏文本、批注和元数据）以及离线检查结果的摘要，将使用你的 API 密钥发送给 %@，并适用这些公司的条款和价格。文件本身不会被发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此檔案擷取出的文字（包括隱藏文字、註解和元資料）以及離線檢查結果的摘要，將使用你的 API 金鑰傳送給 %@，並適用這些公司的條款和價格。檔案本身不會被傳送。"
          }
        }
      }
    },
    "This file's original was replaced" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se sustituyó el original de este archivo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルの元のファイルは置き換えられています"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件的原件已被替换"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此檔案的原始檔案已被取代"
          }
        }
      }
    },
    "This format can't be verified" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este formato no se puede verificar"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この形式は検証できません"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此格式无法验证"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此格式無法驗證"
          }
        }
      }
    },
    "This is a Finder attribute, not part of the file. It stays with the copy when you save it, and replaces the original's when you replace the original." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es un atributo del Finder, no parte del archivo. Se queda con la copia cuando la guardas y sustituye al del original cuando sustituyes el original."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これは Finder の属性で、ファイルの中身の一部ではありません。コピーを保存するとコピーに残り、元のファイルを置き換えると元のファイルの記録と入れ替わります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是 Finder 的属性，不是文件内容的一部分。存储副本时它会随副本保留；替换原件时它会取代原件的记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是 Finder 的屬性，不是檔案內容的一部分。儲存副本時它會隨副本保留；取代原始檔案時它會取代原始檔案的記錄。"
          }
        }
      }
    },
    "This model found nothing." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este modelo no encontró nada."
