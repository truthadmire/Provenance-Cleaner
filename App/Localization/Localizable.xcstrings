    "Checking and rebuilding are turned off for this file, because the file on disk is now the copy. To work from the previous version, add %@ after renaming it back." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La comprobación y la reconstrucción están desactivadas para este archivo, porque el archivo del disco ya es la copia. Para trabajar con la versión anterior, añade %@ después de devolverle su nombre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスク上のファイルはすでにコピーなので、このファイルのチェックと再作成はオフになっています。以前のバージョンから作業するには、%@ の名前を元に戻してから追加してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件的检查和重建功能已关闭，因为磁盘上的文件现在就是副本。要基于之前的版本操作，请先把 %@ 改回原名，再添加它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此檔案的檢查和重建功能已關閉，因為磁碟上的檔案現在就是副本。若要從先前的版本開始，請先把 %@ 改回原名，再加入它。"
          }
        }
      }
    },
