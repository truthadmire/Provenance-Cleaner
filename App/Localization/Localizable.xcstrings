          "stringUnit" : {
            "state" : "translated",
            "value" : "原始檔案顯示："
          }
        }
      }
    },
    "The original's download-source record (Finder's \"Where from\") was not carried over. Tags, comments and permissions were kept." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
