    "Save copy suggests the name %@. Replacing the original keeps the old version as %@.bak, next to it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Save copy suggests the name %1$@. Replacing the original keeps the old version as %2$@.bak, next to it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Guardar copia» propone el nombre %1$@. Al sustituir el original, la versión anterior se conserva como %2$@.bak, junto a él."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「コピーを保存」では %1$@ という名前を提案します。元のファイルを置き換えると、古いバージョンは隣に %2$@.bak として残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“存储副本”建议的名称是 %1$@。替换原件时，旧版本会保留为旁边的 %2$@.bak。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「儲存副本」建議的名稱是 %1$@。取代原始檔案時，舊版本會保留為旁邊的 %2$@.bak。"
          }
        }
      }
    },
