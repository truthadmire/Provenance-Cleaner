          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元のファイルのダウンロード元の記録（Finder の「入手先」）は引き継がれていません。タグ、コメント、アクセス権は保持されています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原件的下载来源记录（Finder 的“来源”）没有保留。标签、备注和权限都已保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
