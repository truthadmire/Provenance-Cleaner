    "Counts cover the displayed comparison. Each side is limited to %@ Unicode code points, with at most %@ code points from a large changed region." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Counts cover the displayed comparison. Each side is limited to %1$@ Unicode code points, with at most %2$@ code points from a large changed region."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los recuentos cubren la comparación mostrada. Cada lado se limita a %1$@ puntos de código Unicode, con un máximo de %2$@ puntos de código de una región muy modificada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "件数は表示中の比較が対象です。片側は最大 %1$@ Unicode コードポイントで、大きく変更された部分からは最大 %2$@ コードポイントです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "计数只涵盖显示出的比较内容。每侧最多 %1$@ 个 Unicode 码位，其中来自大范围更改区域的最多 %2$@ 个码位。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計數只涵蓋顯示的比較內容。每側最多 %1$@ 個 Unicode 碼位，其中來自大範圍變更區域的最多 %2$@ 個碼位。"
          }
        }
      }
    },
