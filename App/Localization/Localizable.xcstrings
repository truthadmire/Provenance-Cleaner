    },
    "Use Provenance Cleaner only with files you own or are allowed to change. Removing provenance doesn't change who made a file or who may use it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Provenance Cleaner solo con archivos que te pertenezcan o que puedas modificar. Eliminar la procedencia no cambia quién creó un archivo ni quién puede usarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provenance Cleaner は、自分が所有しているか変更を許可されているファイルにだけ使ってください。来歴を削除しても、ファイルの作成者や利用できる人が変わるわけではありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请只对你拥有或有权更改的文件使用 Provenance Cleaner。移除来源信息并不会改变文件的制作者，也不会改变谁有权使用它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請只對你擁有或有權變更的檔案使用 Provenance Cleaner。移除來源資訊並不會改變檔案的製作者，也不會改變誰有權使用它。"
          }
        }
      }
    },
    "Use at most %lld entries of up to 4,096 characters, without control characters." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
