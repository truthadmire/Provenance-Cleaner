    "Leave it empty and the copy has no download source. Browsers record the file's link first, then the page it was downloaded from." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si lo dejas vacío, la copia no tendrá origen de descarga. Los navegadores registran primero el enlace del archivo y después la página desde la que se descargó."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空欄のままにすると、コピーにダウンロード元は記録されません。ブラウザは、まずファイルのリンク、次にダウンロード元のページを記録します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留空则副本没有下载来源。浏览器会先记录文件的链接，再记录下载它的页面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留空則副本沒有下載來源。瀏覽器會先記錄檔案的連結，再記錄下載它的頁面。"
          }
        }
      }
    },
