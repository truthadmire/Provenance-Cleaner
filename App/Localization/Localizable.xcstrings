    "Keep ordinary metadata" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservar metadatos habituales"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一般的なメタデータを保持"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留普通元数据"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留一般元資料"
          }
        }
      }
    },
    "Keeps camera, date, location and other ordinary details. Only fields related to AI generation or provenance are removed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva la cámara, la fecha, la ubicación y otros datos habituales. Solo se quitan los campos relacionados con la generación por IA o la procedencia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラ、日付、位置情報などの一般的な情報は残し、AI 生成や来歴に関するフィールドだけを削除します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留相机、日期、位置等普通信息，只移除与 AI 生成或来源相关的字段。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留相機、日期、位置等一般資訊，只移除與 AI 生成或來源相關的欄位。"
          }
        }
      }
    },
    "Keeps ordinary details where the format allows. Office files always lose author, last saved by, subject, keywords, description and company; set them again under Document properties." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva los datos habituales cuando el formato lo permite. Los archivos de Office siempre pierden autor, guardado por última vez por, asunto, palabras clave, descripción y empresa; puedes volver a definirlos en «Propiedades del documento»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "形式が許す範囲で一般的な情報を残します。Office ファイルでは、作成者、最終保存者、件名、キーワード、説明、会社が必ず削除されます。「書類のプロパティ」で再設定できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在格式允许时保留普通信息。Office 文件总会丢失作者、上次存储者、主题、关键词、描述和公司；可在“文档属性”中重新设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在格式允許時保留一般資訊。Office 檔案總會失去作者、上次儲存者、主旨、關鍵字、描述和公司；可在「文件屬性」中重新設定。"
          }
        }
      }
    },
    "Kept on purpose, for your information:" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservado a propósito, para tu información:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "意図的に残したもの（参考）："
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有意保留，仅供参考："
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刻意保留，僅供參考："
