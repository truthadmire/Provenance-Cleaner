    "Editing rewrites the PDF, so earlier property values are removed from it. Names in the page text, comments or attachments aren't changed." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editar reescribe el PDF, así que se eliminan de él los valores anteriores de las propiedades. Los nombres del texto de las páginas, los comentarios o los adjuntos no cambian."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編集すると PDF が書き直されるため、以前のプロパティ値は削除されます。ページのテキスト、コメント、添付ファイル内の名前は変わりません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "编辑会重写 PDF，因此其中较早的属性值会被移除。页面文本、批注或附件中的姓名不会改变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編輯會重寫 PDF，因此其中較早的屬性值會被移除。頁面文字、註解或附件中的姓名不會改變。"
          }
        }
      }
    },
    "Editing-trace changes require a DOCX file." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cambios de rastros de edición requieren un archivo DOCX."
