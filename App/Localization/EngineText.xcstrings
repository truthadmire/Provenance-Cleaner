      }
    },
    "Edits may invalidate existing content credentials or digital signatures. Re-inspect the saved result." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ediciones pueden invalidar las credenciales de contenido o firmas digitales existentes. Vuelve a comprobar el resultado guardado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編集すると、既存のコンテンツ認証情報やデジタル署名が無効になることがあります。保存した結果をもう一度チェックしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "编辑可能使现有的内容凭证或数字签名失效。请重新检查存储后的结果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編輯可能使現有的內容憑證或數位簽章失效。請重新檢查儲存後的結果。"
          }
        }
