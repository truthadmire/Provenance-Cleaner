    "Only this file's embedded metadata is checked; text in the image or recording itself isn't read." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se comprueban los metadatos incrustados de este archivo; no se lee el texto de la propia imagen o grabación."
