    "A recorded date is malformed or empty. Choose Remove or Keep for dates." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una fecha registrada está mal formada o vacía. Elige «Eliminar» o «Conservar» para las fechas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録された日付に不正な形式または空のものがあります。日付には「削除」か「保持」を選んでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有一个记录的日期格式错误或为空。请为日期选择“移除”或“保留”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有一個記錄的日期格式錯誤或為空。請為日期選擇「移除」或「保留」。"
          }
        }
      }
    },
